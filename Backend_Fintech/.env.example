# Backend environment variables (copy to .env)
# Required: DB_PASSWORD, JWT_SECRET, JWT_REFRESH_SECRET (no defaults in application code)

NODE_ENV=development
PORT=3000

# Database — use root for local MySQL, or fintech_user when using Docker Compose
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fintech_db
DB_USER=root
DB_PASSWORD=changeme

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Authentication
SESSION_IDLE_MINUTES=15
TRUST_DEVICE_DAYS=30
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=59
RESET_TOKEN_EXPIRY_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30
BCRYPT_ROUNDS=12
REFRESH_TOKEN_COOKIE_NAME=refreshToken

# CORS
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=debug

# Application metadata (optional — version falls back to package.json)
APP_VERSION=
APP_BUILD=local
APP_COMMIT=unknown

# AI Assistant
AI_PROVIDER=gemini
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.7
AI_TOP_P=0.95
AI_MAX_PROMPT_LENGTH=4000
AI_RATE_LIMIT_PER_MINUTE=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Execution layer
CONFIG_ENCRYPTION_KEY=change-this-to-a-secure-config-encryption-key
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
WORKER_POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=5
WORKER_BATCH_SIZE=10
WEBHOOK_TIMEOUT_MS=15000
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_RETRY_MAX_SECONDS=3600
