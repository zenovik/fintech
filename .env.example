# Root environment variables (copy to .env for local / Docker usage)
# For production deployment, use .env.production.example instead.

# Application
NODE_ENV=development

# Ports
FRONTEND_PORT=4200
BACKEND_PORT=3000
MYSQL_PORT=3306

# MySQL
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=fintech_db
MYSQL_USER=fintech_user
MYSQL_PASSWORD=changeme

# Backend (used by Backend_Fintech)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fintech_db
DB_USER=fintech_user
DB_PASSWORD=changeme

JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:4200

# Execution layer
CONFIG_ENCRYPTION_KEY=change-this-to-a-secure-config-encryption-key
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# AI Assistant
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
