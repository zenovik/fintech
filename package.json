{
  "name": "fintech-application",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Merchant Management Portal - Payment Gateway",
  "workspaces": [
    "Frontend_Fintech",
    "Backend_Fintech"
  ],
  "scripts": {
    "install:all": "npm install && npm install --workspace=Frontend_Fintech && npm install --workspace=Backend_Fintech",
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run start --workspace=Frontend_Fintech",
    "dev:backend": "npm run dev --workspace=Backend_Fintech",
    "build": "npm run build --workspace=Backend_Fintech && npm run build --workspace=Frontend_Fintech",
    "build:frontend": "npm run build --workspace=Frontend_Fintech",
    "build:backend": "npm run build --workspace=Backend_Fintech",
    "lint": "npm run lint --workspace=Frontend_Fintech && npm run lint --workspace=Backend_Fintech",
    "lint:fix": "npm run lint:fix --workspace=Frontend_Fintech && npm run lint:fix --workspace=Backend_Fintech",
    "format": "prettier --write \"**/*.{ts,js,json,scss,css,html,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,scss,css,html,md,yml,yaml}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "db:build": "powershell -NoProfile -ExecutionPolicy Bypass -File Database_Fintech/scripts/build-master.ps1",
    "db:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File Database_Fintech/scripts/validate-database-build.ps1",
    "db:generate-enterprise": "node Database_Fintech/scripts/generate-enterprise-seed.mjs",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File Database_Fintech/scripts/setup-database.ps1",
    "db:setup:unix": "bash Database_Fintech/scripts/setup-database.sh",
    "build:prod": "npm run build --workspace=Backend_Fintech && npm run build --workspace=Frontend_Fintech -- --configuration=production",
    "start:prod": "npm run start --workspace=Backend_Fintech",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop fintech-backend",
    "pm2:logs": "pm2 logs fintech-backend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:install": "playwright install chromium",
    "perf:smoke": "node performance/scripts/run.mjs smoke",
    "perf:load": "node performance/scripts/run.mjs load",
    "perf:stress": "node performance/scripts/run.mjs stress",
    "perf:spike": "node performance/scripts/run.mjs spike",
    "perf:soak": "node performance/scripts/run.mjs soak",
    "perf": "node performance/scripts/run.mjs smoke",
    "security:audit": "node security/scripts/audit-deps.mjs",
    "security:zap": "node security/scripts/run-zap.mjs baseline",
    "security:zap:full": "node security/scripts/run-zap.mjs full",
    "security:zap:all": "node security/scripts/run-zap.mjs all",
    "security:summary": "node security/scripts/generate-summary.mjs",
    "security": "npm run security:audit && npm run test:unit --workspace=Backend_Fintech"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@angular/animations": "19.2.19",
    "@angular/cdk": "19.2.19",
    "@angular/common": "19.2.19",
    "@angular/compiler": "19.2.19",
    "@angular/core": "19.2.19",
    "@angular/forms": "19.2.19",
    "@angular/material": "19.2.19",
    "@angular/platform-browser": "19.2.19",
    "@angular/platform-browser-dynamic": "19.2.19",
    "@angular/router": "19.2.19"
  }
}
