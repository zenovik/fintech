# Production environment template (copy to .env before deploying)
# Required variables are enforced by docker-compose and the backend at startup.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=production

# -----------------------------------------------------------------------------
# Ports (host mapping)
# -----------------------------------------------------------------------------
FRONTEND_PORT=4200
BACKEND_PORT=3000
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=fintech_db
MYSQL_USER=fintech_user
MYSQL_PASSWORD=replace-with-strong-db-password

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fintech_db
DB_USER=fintech_user
DB_PASSWORD=replace-with-strong-db-password

JWT_SECRET=replace-with-long-random-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Browser origin for the frontend (no trailing slash)
CORS_ORIGIN=http://localhost:4200

# Authentication
SESSION_IDLE_MINUTES=15
TRUST_DEVICE_DAYS=30
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=59
RESET_TOKEN_EXPIRY_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30
BCRYPT_ROUNDS=12
REFRESH_TOKEN_COOKIE_NAME=refreshToken

# Logging
LOG_LEVEL=info

# Application metadata (optional — version falls back to package.json)
APP_VERSION=
APP_BUILD=production
APP_COMMIT=unknown

# AI Assistant
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
